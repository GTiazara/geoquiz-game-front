# URL de base de l’API (avec /api). En dev, laisser /api : Vite redirige vers API_PROXY_TARGET.
VITE_API_BASE_URL=/api
# Cible du proxy de développement
API_PROXY_TARGET=http://localhost:3000
# Chemin de publication (ex. /geoquiz-game-front/ sur GitHub Pages) — défini automatiquement par le workflow
# VITE_BASE_PATH=/
# Routage : history (défaut) ou hash (obligatoire sur GitHub Pages)
# VITE_ROUTER_MODE=hash
# Suivi Matomo optionnel en local (laisser vide pour désactiver).
# Le workflow GitHub Pages utilise cette instance et le site 5 par défaut.
# VITE_MATOMO_URL=https://matomo.gtiazara.fr/
# VITE_MATOMO_SITE_ID=5
